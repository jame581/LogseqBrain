{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/awk-guard.sh\" portability",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/awk-guard.sh\" tests",
            "asyncRewake": true,
            "timeout": 300
          }
        ]
      }
    ]
  }
}
