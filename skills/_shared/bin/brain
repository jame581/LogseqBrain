#!/bin/sh
# logseq-brain helper — invoke as: sh <plugin>/skills/_shared/bin/brain [--graph DIR] <command> [args]
# How skills call it: skills/_shared/run-brain.md
# Design: docs/superpowers/specs/2026-09-11-v0.11.0-design.md
set -u
LC_ALL=C; export LC_ALL
BRAIN_VERSION=0.11.0
BIN_DIR=$(cd "$(dirname "$0")" && pwd)
LIB=$(cd "$BIN_DIR/../lib" && pwd)
AWK=${BRAIN_AWK:-awk}
NL='
'; CR=$(printf '\r'); TAB=$(printf '\t')

die() { printf 'brain: %s\n' "$1" >&2; exit "${2:-2}"; }

usage() {
  cat <<'EOF'
usage: brain <command> [args] [--graph DIR]
  --graph may appear anywhere; -- ends flag parsing
  info                                  version, graph source, awk in use
  sections <page> [--baseline FILE…]    section table; records baselines for check
  read <page> <section> [--max BYTES]   whole section if under the cap (default 8192)
  tail <page> <section> [--entries N] [--max BYTES]
  digest <page> [--apply]               digest + checks; --apply rewrites only the Map line
  search <term> [--page P] [--section S] [--context N]
  journal <page> [--date yyyy-MM-dd]    that page's mentions in a journal, shrunk to ~2 KB
  check <file…>                         lint lines added since each file's baseline
  lint [--all | <file…>]                every rule over whole files
  status                                one TSV row per project and task page
  activity <line>                       append "HH:MM <line>" under today's ## Activity
  load <page> [--mode digest|full]      info, digest, journal, then the (digest) activity line
  save-begin <page> [--also FILE…]      baselines, digest, Session Log tail, Current Plan, Edit anchors
  save-finish <page> [--summary T] [--index T]
                                        validate; Sessions, Index, Maps; check the save; activity
EOF
}

to_posix() {
  case $1 in
    *\\*|?:*)
      if command -v cygpath >/dev/null 2>&1; then cygpath -u "$1"
      else printf '%s\n' "$1" | tr '\\' '/'; fi ;;
    *) printf '%s\n' "$1" ;;
  esac
}

config_file() {
  if [ -n "${APPDATA:-}" ]; then printf '%s/logseq-brain/config.json\n' "$(to_posix "$APPDATA")"
  elif [ -n "${XDG_CONFIG_HOME:-}" ]; then printf '%s/logseq-brain/config.json\n' "$XDG_CONFIG_HOME"
  else printf '%s/.config/logseq-brain/config.json\n' "$HOME"; fi
}

# json_get KEY FILE — scalar value of "KEY" (string, bool or number); JSON \x escapes undone.
json_get() {
  [ -r "$2" ] || return 0
  $AWK -v BINMODE=3 -v k="$1" 'BEGIN { RS = "\001" }
  {
    s = $0; i = index(s, "\"" k "\""); if (!i) exit
    s = substr(s, i + length(k) + 2); sub(/^[ \t\r\n]*:[ \t\r\n]*/, "", s)
    if (substr(s, 1, 1) == "\"") {
      out = ""
      for (j = 2; j <= length(s); j++) {
        c = substr(s, j, 1)
        if (c == "\\") { j++; out = out substr(s, j, 1); continue }
        if (c == "\"") break
        out = out c
      }
      print out
    } else if (match(s, /^[A-Za-z0-9.]+/)) print substr(s, RSTART, RLENGTH)
    exit
  }' "$2"
}

GRAPH=; GRAPH_SRC=
resolve_graph() {
  for src in flag env config; do
    case $src in
      flag)   g=${OPT_GRAPH:-} ;;
      env)    g=${LOGSEQ_BRAIN_PATH:-} ;;
      config) g=$(json_get graphPath "$(config_file)") ;;
    esac
    [ -n "$g" ] || continue
    g=$(to_posix "$g")
    if [ -d "$g" ]; then GRAPH=${g%/}; GRAPH_SRC=$src; return 0; fi
    [ "$src" = flag ] && die "graph not found: $g"
  done
  die "graph not resolved — pass --graph DIR, set LOGSEQ_BRAIN_PATH, or set graphPath in $(config_file)"
}

valid_date() {
  case $1 in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) return 0 ;; esac
  printf 'brain: not a yyyy-MM-dd date: %s\n' "$1" >&2; return 2
}
now_hm() { printf '%s\n' "${BRAIN_NOW:-$(date +%H:%M)}"; }

# State directory, run directory and today's date: resolved once, here in the main shell.
# Resolved inside $( ) instead, a die would exit only the subshell and could not stop the run —
# the caller would get a full section table *and* a failure, or a temp path at the filesystem root.
STATE_DIR=; RUN_DIR=; TODAY=; INFLIGHT=; ROLLBACK=

cleanup() {
  if [ -n "$INFLIGHT" ] && [ -n "$ROLLBACK" ] && [ -f "$ROLLBACK" ]; then
    _i=$INFLIGHT; INFLIGHT=
    if cat "$ROLLBACK" > "$GRAPH/$_i" 2>/dev/null
    then printf 'brain: interrupted mid-write — %s restored\n' "$_i" >&2
    else printf 'brain: interrupted mid-write — %s NOT restored; recover it from %s\n' "$_i" "$ROLLBACK" >&2; fi
  fi
  INFLIGHT=
  [ -n "$RUN_DIR" ] && rm -rf "$RUN_DIR"
  RUN_DIR=
  return 0
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# init_run — before any command that needs graph state or today's date. Per-run file names:
# two concurrent runs once shared check.lst/lint.out/… and reported each other's findings.
init_run() {
  TODAY=${BRAIN_TODAY:-$(date +%Y-%m-%d)}
  valid_date "$TODAY" || exit 2
  STATE_DIR="${TMPDIR:-/tmp}/logseq-brain/$(printf '%s' "$GRAPH" | cksum | cut -d' ' -f1)"
  RUN_DIR="$STATE_DIR/run.$$"
  # Capture the path before clearing RUN_DIR (which stops the cleanup trap touching a dir we never
  # made): clearing it first left die printing "cannot create state dir" with nothing after it.
  mkdir -p "$STATE_DIR/base" "$RUN_DIR" || { _rd=$RUN_DIR; RUN_DIR=; die "cannot create state dir $_rd"; }
}

nonl() {
  if [ -s "$1" ] && [ "$(tail -c 1 "$1" | wc -l | tr -d ' ')" = 0 ]; then echo 1; else echo 0; fi
}

# guard_rel REL — refuse anything that could leave the graph's pages/ or journals/.
guard_rel() {
  case $1 in
    *..*|/*) die "path outside the graph: $1" ;;
    pages/*|journals/*) ;;
    *) die "path outside pages/ or journals/: $1" ;;
  esac
}

PAGE_REL=; PAGE_NAME=
resolve_page() {
  _p=$1
  case $_p in
    *.md) _rel=${_p#"$GRAPH"/}; guard_rel "$_rel" ;;
    *)    _rel="pages/$(printf '%s' "$_p" | sed 's#/#___#g').md" ;;
  esac
  if [ ! -f "$GRAPH/$_rel" ]; then
    case $_p in
      */*|*.md) ;;
      *) for _pre in Projects___ Tasks___; do
           if [ -f "$GRAPH/pages/$_pre$_p.md" ]; then _rel="pages/$_pre$_p.md"; break; fi
         done ;;
    esac
  fi
  if [ ! -f "$GRAPH/$_rel" ]; then
    printf 'brain: page not found: %s\n' "$_p" >&2
    _key=$(printf '%s' "$_p" | sed 's#\.md$##; s#___#/#g; s#.*/##')
    ls "$GRAPH/pages" 2>/dev/null | sed 's#\.md$##; s#___#/#g' | grep -i -F -- "$_key" \
      | head -n 5 | sed 's/^/  did you mean: /' >&2
    exit 2
  fi
  PAGE_REL=$_rel
  PAGE_NAME=$(basename "$_rel" .md | sed 's#___#/#g')
}

# run_awk PROG [awk args…] — core.awk is always loaded first.
# BINMODE=3: gawk on Windows otherwise reads in text mode and drops \r. Other awks ignore it.
run_awk() { _prog=$1; shift; $AWK -v BINMODE=3 -f "$LIB/core.awk" -f "$LIB/$_prog.awk" "$@"; }

cmd_info() {
  echo "logseq-brain $BRAIN_VERSION"
  echo "graph-source: $GRAPH_SRC"
  # The one absolute path the helper prints: skills use it for their own Read/Edit/Write.
  printf 'graph: %s\n' "$(cygpath -m "$GRAPH" 2>/dev/null || printf '%s' "$GRAPH")"
  _v=$($AWK --version 2>/dev/null | head -n 1)
  [ -n "$_v" ] || _v=$($AWK -W version 2>/dev/null | head -n 1)
  echo "awk: ${_v:-unknown}"
}

# save_baseline REL — snapshot a graph file (empty if it does not exist yet) for `brain check`.
save_baseline() {
  guard_rel "$1"
  _sd="$STATE_DIR/base"
  _key=$(printf '%s' "$1" | sed 's#/#%#g')
  if [ -f "$GRAPH/$1" ]; then cp "$GRAPH/$1" "$_sd/$_key"; else : > "$_sd/$_key"; fi
  date +%s > "$_sd/$_key.ts"
}

cmd_sections() {
  [ $# -ge 1 ] || die "usage: brain sections <page> [--baseline FILE…]"
  resolve_page "$1"; shift
  _f="$GRAPH/$PAGE_REL"
  run_awk sections -v rel="$PAGE_REL" -v nonl="$(nonl "$_f")" "$_f" || die "sections failed on $PAGE_REL"
  save_baseline "$PAGE_REL"; _saved=$PAGE_REL
  if [ "${1:-}" = --baseline ]; then
    shift
    for _b in "$@"; do _b=${_b#"$GRAPH"/}; save_baseline "$_b"; _saved="$_saved $_b"; done
  fi
  printf '# baseline saved: %s\n' "$_saved"
}

# cmd_read_tail read|tail <page> <section> [--max BYTES] [--entries N]
cmd_read_tail() {
  _mode=$1; shift
  [ $# -ge 2 ] || die "usage: brain $_mode <page> <section> [--max BYTES] [--entries N]"
  resolve_page "$1"; _sec=$2; shift 2
  # The heading as written on the page ("## X", "- ## X") names the same section as "X".
  _sec=${_sec#- }; _sec=${_sec#"## "}
  if [ "$_mode" = read ]; then _max=8192; else _max=4096; fi
  _n=3
  while [ $# -gt 0 ]; do
    case $1 in
      --max)     [ $# -ge 2 ] || die "--max needs a number"; _max=$2; shift 2 ;;
      --entries) [ $# -ge 2 ] || die "--entries needs a number"; _n=$2; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  _f="$GRAPH/$PAGE_REL"
  # Same guard as digest_report, without a state dir: read/tail must work on an unwritable TMPDIR.
  # $( ) strips the trailing newline that printf puts back, so the bytes are unchanged.
  _out=$(run_awk read -v rel="$PAGE_REL" -v nonl="$(nonl "$_f")" -v mode="$_mode" \
    -v sec="$_sec" -v max="$_max" -v entries="$_n" "$_f"); _rc=$?
  [ "$_rc" = 2 ] && exit 2                              # read.awk already named the reason
  [ "$_rc" -le 1 ] || die "$_mode failed on $PAGE_REL (awk exit $_rc)"
  [ -n "$_out" ] || die "$_mode failed on $PAGE_REL — the read engine produced no output"
  printf '%s\n' "$_out"
  return $_rc
}

ARCH=
archive_of() {  # sets ARCH for a project page that has a SessionArchive page
  ARCH=
  case $PAGE_REL in
    pages/Projects___*) [ -f "$GRAPH/${PAGE_REL%.md}___SessionArchive.md" ] && ARCH="[[$PAGE_NAME/SessionArchive]]" ;;
  esac
}

# map_awk MODE FILE — map.awk over FILE (PAGE_REL/ARCH already set).
map_awk() {
  run_awk map -v rel="$PAGE_REL" -v nonl="$(nonl "$2")" -v today="$TODAY" -v archive="$ARCH" -v mode="$1" "$2"
}

# digest_report FILE — map.awk's report, guarded. Exit 1 here means findings (§1.4); any other
# code, or no output at all, means the engine never ran and must not be reported as findings.
digest_report() {
  _ro="$RUN_DIR/report.out"
  map_awk report "$1" > "$_ro"; _rc=$?
  [ "$_rc" -le 1 ] || die "digest failed on $PAGE_REL (awk exit $_rc)"
  [ -s "$_ro" ] || die "digest failed on $PAGE_REL — the report engine produced no output"
  cat "$_ro"
  return $_rc
}

cmd_digest() {
  [ $# -ge 1 ] || die "usage: brain digest <page> [--apply]"
  resolve_page "$1"; shift
  archive_of
  if [ "${1:-}" = --apply ]; then cmd_digest_apply; return; fi
  digest_report "$GRAPH/$PAGE_REL"
}

# commit_write REL TMP MAX_OLD MAX_NEW SUM_BEFORE [WANT] — verify TMP against the target, then write in place.
commit_write() {
  case $1 in
    *..*|/*) rm -f "$2"; die "refusing to write outside the graph: $1" ;;
    pages/*.md|journals/*.md) ;;
    *) rm -f "$2"; die "refusing to write outside pages/ or journals/: $1" ;;
  esac
  _t="$GRAPH/$1"; _old=$_t
  [ -f "$_t" ] || _old=/dev/null
  if [ -f "$_t" ] && cmp -s "$2" "$_t"; then rm -f "$2"; COMMITTED=0; return 0; fi
  if ! $AWK -v BINMODE=3 -v max_old="$3" -v max_new="$4" -v want="${6:-}" -f "$LIB/onechange.awk" "$_old" "$2"; then
    rm -f "$2"; exit 2
  fi
  if [ -f "$_t" ] && [ "$(nonl "$_t")" != "$(nonl "$2")" ]; then
    rm -f "$2"; die "refusing to write — final-newline status of $1 would change"
  fi
  [ -n "${BRAIN_TEST_MUTATE_BEFORE_COMMIT:-}" ] && printf ' ' >> "$_t"   # test-only hook
  if [ -f "$_t" ]; then _now=$(cksum < "$_t"); else _now=absent; fi
  if [ "$_now" != "$5" ]; then rm -f "$2"; die "$1 changed during apply — rerun"; fi
  # §2.5 mandates this in-place `cat`, which opens the target O_TRUNC. Stage a rollback copy first:
  # any failure after that point — SIGINT, ENOSPC, a dropped sync mount (this graph usually lives on
  # synced storage) — would otherwise leave the page truncated, with "write failed" reading as
  # though nothing had happened. The cleanup trap restores the same copy if we are interrupted.
  ROLLBACK=
  if [ -f "$_t" ]; then
    ROLLBACK="$STATE_DIR/rollback.$$"
    cp "$_t" "$ROLLBACK" || { ROLLBACK=; rm -f "$2"; die "cannot stage a rollback copy of $1 — refusing to write"; }
  fi
  INFLIGHT=$1
  if [ -n "${BRAIN_TEST_FAIL_COMMIT:-}" ]; then : > "$_t"; _wrc=1   # test-only hook: truncate, then fail
  else cat "$2" > "$_t"; _wrc=$?; fi
  INFLIGHT=
  if [ "$_wrc" != 0 ]; then
    rm -f "$2"
    if [ -z "$ROLLBACK" ]; then
      rm -f "$_t"
      die "write failed: $1 — nothing existed there before, so the partial file was removed"
    fi
    if cat "$ROLLBACK" > "$_t" 2>/dev/null; then
      _rbp=$ROLLBACK; ROLLBACK=; rm -f "$_rbp"
      die "write failed: $1 — the original was restored, the page is unchanged"
    fi
    _rbp=$ROLLBACK; ROLLBACK=
    die "write failed: $1 — the original could NOT be restored; recover it from $_rbp"
  fi
  if [ -n "$ROLLBACK" ]; then rm -f "$ROLLBACK"; ROLLBACK=; fi
  rm -f "$2"; COMMITTED=1
}

# The --apply steps are separate so a composite can validate every Map before writing any file
# (compute), write them later (commit), and run one check over a whole save (report is apply's own).
# apply_compute FILE OUT — the would-be page in OUT. Returns 0, or 2 when map.awk refused and
# already named the reason, or 3 when the engine failed (reason printed here). Never exits.
apply_compute() {
  map_awk apply "$1" > "$2"; _ac=$?
  [ "$_ac" = 2 ] && { rm -f "$2"; return 2; }
  if [ "$_ac" != 0 ]; then rm -f "$2"; printf 'brain: digest failed on %s (awk exit %s)\n' "$PAGE_REL" "$_ac" >&2; return 3; fi
  [ -s "$2" ] || { rm -f "$2"; printf 'brain: digest failed on %s — the apply engine produced no output\n' "$PAGE_REL" >&2; return 3; }
  return 0
}

# apply_commit REL OUT SUM — write the Map line from OUT; SUM is the page's cksum when OUT was computed.
apply_commit() {
  commit_write "$1" "$2" 1 1 "$3" '^[ \t]*- Map: '
  if [ "$COMMITTED" = 1 ]; then printf 'applied: Map line written to %s\n' "$1"
  else printf 'unchanged: Map line already current in %s\n' "$1"; fi
}

# apply_report — digest --apply's own tail: the report, then a check of the page's added lines.
apply_report() {
  digest_report "$GRAPH/$PAGE_REL"; _r1=$?
  echo "--"
  SKIP_DIGEST_LINT=1; cmd_check "$PAGE_REL"; _r2=$?; SKIP_DIGEST_LINT=
  [ "$_r1" = 0 ] && [ "$_r2" = 0 ]
}

cmd_digest_apply() {
  _f="$GRAPH/$PAGE_REL"
  _sum=$(cksum < "$_f")
  _tmp="$RUN_DIR/apply"
  apply_compute "$_f" "$_tmp" || exit 2
  apply_commit "$PAGE_REL" "$_tmp" "$_sum"
  apply_report
}

graph_lists() {
  PAGES_LST="$RUN_DIR/pages.lst"; KEYS_LST="$RUN_DIR/keys.lst"
  ls "$GRAPH/pages" 2>/dev/null | sed -n 's#\.md$##p' | sed 's#___#/#g' | tr 'A-Z' 'a-z' > "$PAGES_LST"
  (cd "$GRAPH" && grep -h -E '^[[:space:]]*(- )?[A-Za-z0-9_][A-Za-z0-9_.-]*:: ' pages/*.md journals/*.md 2>/dev/null) \
    | sed -E 's/^[[:space:]]*(- )?([A-Za-z0-9_][A-Za-z0-9_.-]*)::.*/\2/' | tr 'A-Z' 'a-z' | sort | uniq -c > "$KEYS_LST"
}

# digest_lint REL — map.awk lint findings for one digest-bearing candidate.
digest_lint() {
  case $1 in
    pages/Projects___*|pages/Tasks___*)
      PAGE_REL=$1; PAGE_NAME=$(basename "$1" .md | sed 's#___#/#g'); archive_of
      map_awk lint "$GRAPH/$1" ;;
  esac
  return 0
}

# print_hints FILE — one "fix <rule>: …" line per rule named in column 2 of FILE, first-seen order.
print_hints() { cut -f2 "$1" | $AWK -v BINMODE=3 -f "$LIB/hints.awk"; }

cmd_check() {
  [ $# -ge 1 ] || die "usage: brain check <file|page>…"
  graph_lists
  _crc=0; _rules="$RUN_DIR/check.rules"; : > "$_rules"
  for _a in "$@"; do
    _rel=${_a#"$GRAPH"/}
    case $_rel in pages/*|journals/*) guard_rel "$_rel" ;; *) resolve_page "$_a"; _rel=$PAGE_REL ;; esac
    [ -f "$GRAPH/$_rel" ] || die "no such file: $_rel"
    _b="$STATE_DIR/base/$(printf '%s' "$_rel" | sed 's#/#%#g')"
    _list="$RUN_DIR/check.lst"; printf '%s\n' "$_rel" > "$_list"
    _fresh=0
    if [ -f "$_b" ] && [ -f "$_b.ts" ]; then
      _ts=$(cat "$_b.ts")
      case $_ts in
        ''|*[!0-9]*) ;;
        *) [ $(( $(date +%s) - _ts )) -le 43200 ] && _fresh=1 ;;
      esac
    fi
    _lo="$RUN_DIR/check-lint.out"; _cnt="$RUN_DIR/check.cnt"; : > "$_cnt"
    if [ "$_fresh" = 1 ]; then
      _add="$RUN_DIR/added.lst"
      $AWK -v BINMODE=3 -f "$LIB/added.awk" "$_b" "$GRAPH/$_rel" > "$_add" \
        || die "check failed on $_rel — could not diff it against its baseline"
      (cd "$GRAPH" && run_awk lint -v listfile="$_list" -v pagesfile="$PAGES_LST" -v keysfile="$KEYS_LST" \
        -v addedfile="$_add" -v countfile="$_cnt") > "$_lo"
    else
      (cd "$GRAPH" && run_awk lint -v listfile="$_list" -v pagesfile="$PAGES_LST" -v keysfile="$KEYS_LST" \
        -v nobase=1 -v countfile="$_cnt") > "$_lo"
    fi
    _lrc=$?
    [ "$_lrc" = 2 ] && exit 2                           # lint.awk already named the unreadable file
    [ "$_lrc" -le 1 ] || die "check failed on $_rel (lint engine exit $_lrc)"
    # The verification step of a save: an engine that did not lint the file must not read as clean.
    _nf=$(cut -f1 "$_cnt")
    [ "${_nf:-}" = 1 ] || die "check failed on $_rel — the engine linted ${_nf:-no} file(s), expected 1"
    _ne=$(cut -f2 "$_cnt"); _nw=$(cut -f3 "$_cnt"); _pre=$(cut -f4 "$_cnt")
    [ "$_lrc" = 1 ] && _crc=1
    cat "$_lo"; cat "$_lo" >> "$_rules"
    _ds=
    if [ -z "${SKIP_DIGEST_LINT:-}" ]; then
      _dl="$RUN_DIR/check-digest.out"
      digest_lint "$_rel" > "$_dl"; cat "$_dl"; cat "$_dl" >> "$_rules"
      # Named in the summary, so the summary and the exit code agree: a page whose only new problem
      # is a digest finding used to print "0 new (0 error, 0 warn)" and exit 1.
      _de=$(cut -f3 "$_dl" | grep -c '^error$'); _dw=$(cut -f3 "$_dl" | grep -c '^warn$')
      [ $((_de + _dw)) -gt 0 ] && _ds=" · digest: $_de error, $_dw warn"
      if [ "$_fresh" = 1 ] && [ "$_de" -gt 0 ]; then _crc=1; fi
    fi
    if [ "$_fresh" = 1 ]; then
      printf 'check %s: %d new (%d error, %d warn), %d pre-existing%s\n' \
        "$_rel" "$((_ne + _nw))" "$_ne" "$_nw" "$_pre" "$_ds"
    else
      printf 'check %s: no baseline — %d finding(s) shown, may be pre-existing%s\n' \
        "$_rel" "$((_ne + _nw))" "$_ds"
    fi
  done
  print_hints "$_rules"
  return $_crc
}

cmd_lint() {
  graph_lists
  _list="$RUN_DIR/lint.lst"; _out="$RUN_DIR/lint.out"
  if [ $# -eq 0 ] || [ "$1" = --all ]; then
    # Two ls calls, not one: a single `ls pages/*.md journals/*.md` sorts journals/ before pages/.
    (cd "$GRAPH" && { ls pages/*.md 2>/dev/null; ls journals/*.md 2>/dev/null; }) > "$_list"
  else
    : > "$_list"
    for _a in "$@"; do
      _r=${_a#"$GRAPH"/}; guard_rel "$_r"
      [ -f "$GRAPH/$_r" ] || die "no such file: $_r"
      printf '%s\n' "$_r" >> "$_list"
    done
  fi
  _cnt="$RUN_DIR/lint.cnt"; : > "$_cnt"
  (cd "$GRAPH" && run_awk lint -v listfile="$_list" -v pagesfile="$PAGES_LST" -v keysfile="$KEYS_LST" \
    -v countfile="$_cnt") > "$_out"
  _lrc=$?
  [ "$_lrc" = 2 ] && exit 2                             # lint.awk already named the unreadable file
  [ "$_lrc" = 0 ] || die "lint failed (lint engine exit $_lrc)"
  # An engine that linted fewer files than were listed must not report a clean graph: an empty or
  # truncated count file is a failure, not "0 error, 0 warn".
  _want=$(wc -l < "$_list" | tr -d ' '); _nf=$(cut -f1 "$_cnt")
  [ "${_nf:-}" = "$_want" ] || die "lint failed — the engine linted ${_nf:-no} of $_want file(s)"
  while IFS= read -r _r || [ -n "$_r" ]; do digest_lint "$_r" >> "$_out"; done < "$_list"
  cat "$_out"
  _e=$(cut -f3 "$_out" | grep -c '^error$'); _w=$(cut -f3 "$_out" | grep -c '^warn$')
  _by=$(cut -f2 "$_out" | sort | uniq -c | $AWK -v BINMODE=3 '{ printf "%s%s=%s", (NR > 1 ? " · " : ""), $2, $1 }')
  print_hints "$_out"
  echo "summary: $_e error, $_w warn${_by:+ · $_by}"
  [ $((_e + _w)) -eq 0 ]
}

cmd_search() {
  [ $# -ge 1 ] || die "usage: brain search <term> [--page P] [--section S] [--context N]"
  _term=$1; shift; _pg=; _sec=; _ctx=
  while [ $# -gt 0 ]; do
    case $1 in
      --page)    [ $# -ge 2 ] || die "--page needs a page";     _pg=$2;  shift 2 ;;
      --section) [ $# -ge 2 ] || die "--section needs a name";  _sec=$2; shift 2 ;;
      --context) [ $# -ge 2 ] || die "--context needs a number"; _ctx=$2; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -n "$_sec" ] && [ -z "$_pg" ] && die "--section needs --page"
  _list="$RUN_DIR/search.lst"
  if [ -n "$_pg" ]; then
    resolve_page "$_pg"; printf '%s\n' "$PAGE_REL" > "$_list"; _scope="$PAGE_REL${_sec:+ ## $_sec}"
  else
    (cd "$GRAPH" && { ls pages/*.md 2>/dev/null; ls journals/*.md 2>/dev/null; }) > "$_list"; _scope="pages/, journals/"
  fi
  if [ -n "$_ctx" ]; then
    while IFS= read -r _f || [ -n "$_f" ]; do printf '%s\t%s\n' "$_f" "$(nonl "$GRAPH/$_f")"; done < "$_list" > "$_list.n" && mv "$_list.n" "$_list"
  fi
  (cd "$GRAPH" && BRAIN_TERM=$_term run_awk search -v listfile="$_list" -v sec="$_sec" -v ctx="$_ctx" -v scope="$_scope")
  _rc=$?
  [ "$_rc" = 2 ] && exit 2                              # search.awk already named the reason
  [ "$_rc" = 0 ] || die "search failed (awk exit $_rc)"
}

cmd_journal() {
  [ $# -ge 1 ] || die "usage: brain journal <page> [--date yyyy-MM-dd]"
  resolve_page "$1"; shift
  _d=$TODAY
  if [ "${1:-}" = --date ]; then [ $# -ge 2 ] || die "--date needs yyyy-MM-dd"; _d=$2; valid_date "$_d" || exit 2; fi
  _rel="journals/$(printf '%s' "$_d" | tr '-' '_').md"
  if [ ! -f "$GRAPH/$_rel" ]; then printf 'coverage: no journal for %s (%s)\n' "$_d" "$_rel"; return 0; fi
  run_awk journal -v rel="$_rel" -v nonl="$(nonl "$GRAPH/$_rel")" -v name="$PAGE_NAME" -v target=2048 "$GRAPH/$_rel"
  _rc=$?
  [ "$_rc" = 0 ] || die "journal failed on $_rel (awk exit $_rc)"
}

# flag_text_guard WHAT TEXT — refuse (message on stderr, return 1) text whose first or last word is a
# --graph flag: a quoting slip that would otherwise write the flag (and a path) into the journal.
flag_text_guard() {
  _fg_what=$1; _fg_text=$2
  set -f; set -- $_fg_text; set +f        # split on whitespace, never expand globs
  [ $# -gt 0 ] || return 0
  _fg_first=$1; eval "_fg_last=\${$#}"
  for _fg_w in "$_fg_first" "$_fg_last"; do
    case $_fg_w in
      --graph|--graph=*)
        printf 'brain: %s text contains a --graph flag — pass it outside the text\n' "$_fg_what" >&2; return 1 ;;
    esac
  done
  return 0
}

# validate_text KIND NAME TEXT — Claude-composed text the helper is about to write (KIND summary or
# index), checked before anything is written: one line, the --graph guard, balanced parentheses for
# --index, and no error-tier lint finding. Only the new text is linted (as the bullet it becomes),
# so an old error elsewhere in the file never blocks a save. Warn-tier findings print and pass.
# Returns 1 with the reason printed; never exits.
validate_text() {
  _vt_k=$1; _vt_n=$2; _vt_t=$3
  case $_vt_t in
    *"$NL"*|*"$CR"*) printf 'refusing to write --%s text: it contains a line break\n' "$_vt_k"; return 1 ;;
  esac
  flag_text_guard "$_vt_k" "$_vt_t" || return 1
  if [ "$_vt_k" = index ] && ! printf '%s\n' "$_vt_t" | $AWK -v BINMODE=3 '
      { for (i = 1; i <= length($0); i++) { c = substr($0, i, 1)
          if (c == "(") d++; else if (c == ")" && --d < 0) exit 1 } }
      END { exit (d != 0) }'; then
    printf 'refusing to write --%s text: unbalanced parentheses\n' "$_vt_k"; return 1
  fi
  graph_lists
  _vt_d="$RUN_DIR/prelint"; mkdir -p "$_vt_d/pages" || die "cannot create $_vt_d"
  if [ "$_vt_k" = summary ]; then printf -- '- [[%s]]: %s\n' "$_vt_n" "$_vt_t"
  else printf -- '- %s\n' "$_vt_t"; fi > "$_vt_d/pages/Prelint.md"
  printf 'pages/Prelint.md\n' > "$_vt_d/list"; : > "$_vt_d/cnt"
  (cd "$_vt_d" && run_awk lint -v listfile=list -v pagesfile="$PAGES_LST" -v keysfile="$KEYS_LST" -v countfile=cnt) \
    > "$_vt_d/out" || die "lint failed on the --$_vt_k text"
  [ "$(cut -f1 "$_vt_d/cnt")" = 1 ] || die "lint failed on the --$_vt_k text — the engine did not lint it"
  sed "s#^pages/Prelint\.md:[0-9]*#--$_vt_k text#" "$_vt_d/out"
  if [ "$(cut -f2 "$_vt_d/cnt")" != 0 ]; then
    printf 'refusing to write --%s text: fix it and rerun\n' "$_vt_k"; return 1
  fi
  return 0
}

# write_sessions NAME TEXT — "- [[NAME]]: TEXT" under today's ## Sessions (heading or journal created
# when missing), through the verified single-change commit. An identical bullet is not written twice.
# The guard regexes go through awk -v, so their backslashes are doubled (Global Constraints).
write_sessions() {
  _ws_rel=$(today_file); _ws_t="$GRAPH/$_ws_rel"; _ws_tmp="$RUN_DIR/sessions"
  _ws_bullet="[[$1]]: $2"; _ws_want='^[ \t]*- \\[\\[(Projects|Tasks)/'
  BRAIN_BULLET=$_ws_bullet; export BRAIN_BULLET
  if [ -f "$_ws_t" ]; then
    _ws_sum=$(cksum < "$_ws_t")
    run_awk activity -v section=Sessions -v nonl="$(nonl "$_ws_t")" -v new=0 "$_ws_t" > "$_ws_tmp" \
      || { rm -f "$_ws_tmp"; die "sessions failed on $_ws_rel"; }
    unset BRAIN_BULLET
    if run_awk anchors -v mode=sessions "$_ws_t" | grep -q '^sessions: absent'; then
      commit_write "$_ws_rel" "$_ws_tmp" 0 2 "$_ws_sum" '^(- )?## Sessions|'"$_ws_want"
    else
      commit_write "$_ws_rel" "$_ws_tmp" 0 1 "$_ws_sum" "$_ws_want"
    fi
  else
    mkdir -p "$GRAPH/journals" || die "cannot create journals/"
    run_awk activity -v section=Sessions -v new=1 /dev/null > "$_ws_tmp" \
      || { rm -f "$_ws_tmp"; die "sessions failed on $_ws_rel"; }
    unset BRAIN_BULLET
    commit_write "$_ws_rel" "$_ws_tmp" 0 2 absent '^(- )?## Sessions|'"$_ws_want"
  fi
  if [ "$COMMITTED" = 1 ]; then printf 'sessions: %s → %s\n' "$_ws_bullet" "$_ws_rel"
  else echo "sessions: unchanged"; fi
}

# write_index NAME TEXT — the parenthetical of NAME's one-liner in pages/Index.md becomes "(TEXT)".
# Missing, ambiguous or no Index: nothing is written, the message says what to do, and it returns 0.
write_index() {
  _wi_rel=pages/Index.md; _wi_f="$GRAPH/$_wi_rel"; _wi_tmp="$RUN_DIR/index"
  [ -f "$_wi_f" ] || { echo "index: no pages/Index.md — nothing written"; return 0; }
  _wi_sum=$(cksum < "$_wi_f")
  BRAIN_NAME=$1; BRAIN_PAREN=$2; export BRAIN_NAME BRAIN_PAREN
  run_awk index -v nonl="$(nonl "$_wi_f")" "$_wi_f" > "$_wi_tmp"; _wi_rc=$?
  unset BRAIN_PAREN
  case $_wi_rc in
    0) ;;
    3) rm -f "$_wi_tmp"; unset BRAIN_NAME
       echo "index: missing — add the one-liner under ## Projects with Edit"; return 0 ;;
    4) printf 'index: %s — edit it by hand\n' "$(cat "$_wi_tmp")"; rm -f "$_wi_tmp"; unset BRAIN_NAME; return 0 ;;
    *) rm -f "$_wi_tmp"; die "index failed on $_wi_rel (awk exit $_wi_rc)" ;;
  esac
  # The guard's regex: the name with every ERE metacharacter escaped, backslashes doubled for -v.
  _wi_esc=$(printf '%s' "$1" | sed 's/[][\.*^$+?(){}|/]/\\\\&/g')
  commit_write "$_wi_rel" "$_wi_tmp" 1 1 "$_wi_sum" '\\[\\['"$_wi_esc"'\\]\\]'
  if [ "$COMMITTED" = 1 ]; then
    run_awk anchors -v mode=index "$_wi_f" | sed 's#^index: \([0-9]*\) #index: pages/Index.md line \1: #'
  else echo "index: unchanged"; fi
  unset BRAIN_NAME
}

# today_file — today's journal, graph-relative.
today_file() { printf 'journals/%s.md\n' "$(printf '%s' "$TODAY" | tr '-' '_')"; }

cmd_activity() {
  [ $# -ge 1 ] || die "usage: brain activity <text>"
  flag_text_guard activity "$*" || exit 2
  if [ "$(json_get journeyLog "$(config_file)")" = false ]; then echo "journey log disabled (journeyLog: false)"; return 0; fi
  _rel=$(today_file); _t="$GRAPH/$_rel"
  _line="$(now_hm) $*"
  _tmp="$RUN_DIR/activity"
  if [ -f "$_t" ]; then
    _sum=$(cksum < "$_t")
    BRAIN_BULLET=$_line run_awk activity -v nonl="$(nonl "$_t")" -v new=0 "$_t" > "$_tmp" || { rm -f "$_tmp"; die "activity failed on $_rel"; }
    commit_write "$_rel" "$_tmp" 0 2 "$_sum"
  else
    mkdir -p "$GRAPH/journals" || die "cannot create journals/"
    BRAIN_BULLET=$_line run_awk activity -v new=1 /dev/null > "$_tmp" || { rm -f "$_tmp"; die "activity failed on $_rel"; }
    commit_write "$_rel" "$_tmp" 0 3 absent
  fi
  printf 'activity: %s → %s\n' "$_line" "$_rel"      # not echo: dash's echo expands backslashes
}

# --- composites: one process for a fixed sequence of the commands above; each block is headed
# "== <name>" and holds that command's unchanged output. Composite locals are prefixed (_ld_, _sb_,
# _sf_): the cmd_* functions share un-prefixed globals and reset PAGE_REL/PAGE_NAME.

# load_full_budget REL — the section table without recording baselines (cmd_sections always
# records them), then the bytes a full load reads: each of Overview, Current Plan, Implementation,
# Decisions and Session Log, capped at 8192.
load_full_budget() {
  _ld_f="$GRAPH/$1"; _ld_tab="$RUN_DIR/load-sections.out"
  run_awk sections -v rel="$1" -v nonl="$(nonl "$_ld_f")" "$_ld_f" > "$_ld_tab" || die "sections failed on $1"
  cat "$_ld_tab"
  $AWK -v BINMODE=3 -F '\t' '
    $5 == "Overview" || $5 == "Current Plan" || $5 == "Implementation" || $5 == "Decisions" || $5 == "Session Log" {
      b += ($3 + 0 > 8192 ? 8192 : $3 + 0)
    }
    END { printf "full-budget: %d B\n", b }' "$_ld_tab"
}

cmd_load() {
  [ $# -ge 1 ] || die "usage: brain load <page> [--mode digest|full]"
  _ld_pg=$1; shift; _ld_mode=digest
  if [ "${1:-}" = --mode ]; then [ $# -ge 2 ] || die "--mode needs digest|full"; _ld_mode=$2; shift 2; fi
  [ $# -eq 0 ] || die "unknown option: $1"
  case $_ld_mode in digest|full) ;; *) die "--mode must be digest or full" ;; esac
  resolve_page "$_ld_pg"; archive_of
  _ld_rel=$PAGE_REL; _ld_name=$PAGE_NAME
  echo "== info"; cmd_info
  echo "== digest"; _ld_out="$RUN_DIR/load-digest.out"
  digest_report "$GRAPH/$_ld_rel" > "$_ld_out"; _ld_rc=$?; cat "$_ld_out"
  echo "== journal"; cmd_journal "$_ld_rel"
  if [ "$_ld_mode" = full ]; then echo "== sections"; load_full_budget "$_ld_rel"; return $_ld_rc; fi
  # map.awk prints a map: line only once a ## Digest exists; "digest: missing" and "not applicable"
  # pages get the fallback, and the model logs (brief) only after it has read them.
  if grep -q '^map: ' "$_ld_out"; then
    echo "== activity"; cmd_activity "loaded [[$_ld_name]] (digest)"
  else
    printf "activity: not written — no digest; run the fallback reads, then brain activity 'loaded [[%s]] (brief)'\n" "$_ld_name"
  fi
  return $_ld_rc
}

# worst RC… — the composite exit code: 2 over 1 over 0.
worst() { _wr=0; for _wx in "$@"; do [ "$_wx" -gt "$_wr" ] && _wr=$_wx; done; return $_wr; }

# table_bytes TABLE HEADING — that section's bytes from a section table (first match), or nothing.
table_bytes() { $AWK -v BINMODE=3 -F '\t' -v h="$2" '$5 == h && $1 ~ /^[0-9]+$/ { print $3; exit }' "$1"; }

# save_manifest_path REL — one manifest per page: the files a save baselined, for save-finish.
save_manifest_path() { printf '%s/save.%s.lst\n' "$STATE_DIR" "$(printf '%s' "$1" | sed 's#/#%#g')"; }

# cmd_save_begin PAGE [--also FILE…] — everything a save needs before its first Edit: baselines for
# the page, Index, today's journal and every --also file; the digest; the newest Session Log entry;
# Current Plan; the Index and ## Sessions anchors; and the manifest save-finish checks against.
cmd_save_begin() {
  [ $# -ge 1 ] || die "usage: brain save-begin <page> [--also FILE…]"
  _sb_pg=$1; shift
  if [ $# -gt 0 ]; then
    [ "$1" = --also ] || die "unknown option: $1"
    shift; [ $# -ge 1 ] || die "--also needs at least one file"
  fi
  resolve_page "$_sb_pg"
  _sb_rel=$PAGE_REL; _sb_name=$PAGE_NAME; _sb_journal=$(today_file)
  for _sb_a in "$@"; do guard_rel "${_sb_a#"$GRAPH"/}"; done
  echo "== info"; cmd_info
  echo "== sections"; _sb_tab="$RUN_DIR/save-begin-sections.out"
  cmd_sections "$_sb_rel" --baseline pages/Index.md "$_sb_journal" "$@" > "$_sb_tab"; cat "$_sb_tab"
  PAGE_REL=$_sb_rel; PAGE_NAME=$_sb_name; archive_of
  echo "== digest"; digest_report "$GRAPH/$_sb_rel"; _sb_r1=$?
  echo "== session-log"; _sb_r2=0
  if [ -z "$(table_bytes "$_sb_tab" 'Session Log')" ]; then echo "session-log: none"
  else cmd_read_tail tail "$_sb_rel" "Session Log" --entries 1 --max 4096; _sb_r2=$?; fi
  echo "== current-plan"; _sb_r3=0; _sb_cp=$(table_bytes "$_sb_tab" 'Current Plan')
  if [ -z "$_sb_cp" ]; then echo "current-plan: none"
  elif [ "$_sb_cp" -gt 8192 ]; then cmd_read_tail tail "$_sb_rel" "Current Plan" --max 8192; _sb_r3=$?
  else cmd_read_tail read "$_sb_rel" "Current Plan"; _sb_r3=$?; fi
  echo "== anchors"
  case $_sb_rel in
    pages/Tasks___*) echo "index: not applicable (task page)" ;;
    *) if [ -f "$GRAPH/pages/Index.md" ]; then
         BRAIN_NAME=$_sb_name; export BRAIN_NAME
         run_awk anchors -v mode=index "$GRAPH/pages/Index.md" || die "anchors failed on pages/Index.md"
         unset BRAIN_NAME
       else echo "index: no Index.md"; fi ;;
  esac
  if [ -f "$GRAPH/$_sb_journal" ]; then
    run_awk anchors -v mode=sessions -v nonl="$(nonl "$GRAPH/$_sb_journal")" "$GRAPH/$_sb_journal" \
      || die "anchors failed on $_sb_journal"
  else echo "sessions: no journal"; fi
  # The manifest: this run's files, plus those of a fresh earlier save-begin for the same page (a
  # rerun that adds --also keeps what the first run baselined). Written whole, then renamed.
  _sb_m=$(save_manifest_path "$_sb_rel")
  {
    printf 'file %s\n' "$_sb_rel" pages/Index.md "$_sb_journal"
    for _sb_a in "$@"; do printf 'file %s\n' "${_sb_a#"$GRAPH"/}"; done
    if [ -f "$_sb_m" ] && manifest_fresh "$_sb_m"; then grep '^file ' "$_sb_m"; fi
  } | $AWK '!seen[$0]++' > "$_sb_m.$$.files" || die "cannot write the save manifest"
  { printf 'page %s\n' "$_sb_rel"; cat "$_sb_m.$$.files"; printf 'ts %s\n' "$(date +%s)"; } > "$_sb_m.$$" \
    && mv "$_sb_m.$$" "$_sb_m" || die "cannot write the save manifest"
  rm -f "$_sb_m.$$.files"
  worst "$_sb_r1" "$_sb_r2" "$_sb_r3"
}

# cmd_save_finish PAGE [--summary TEXT] [--index TEXT] — the end of a save, after the model's Edits.
# 1. Validate, writing nothing: the manifest, the texts, the digest caps and a dry-run Map on every
#    digest-bearing page in the save. A refusal leaves the graph as it was; rerun the same command.
# 2-4. The Sessions bullet, the Index parenthetical, the Maps (each checked against the page's
#    checksum at validation, so a page changed since then is refused, not overwritten).
# 5. One check over every file save-begin baselined, digest lint on.
# 6. The activity line — deferred while the save has a new error-tier finding. A completed save
#    consumes its manifest; a deferred one keeps it, so the printed `brain check` has its baselines.
cmd_save_finish() {
  [ $# -ge 1 ] || die "usage: brain save-finish <page> [--summary TEXT] [--index TEXT]"
  _sf_pg=$1; shift; _sf_sum=; _sf_hs=0; _sf_idx=; _sf_hi=0
  while [ $# -gt 0 ]; do
    case $1 in
      --summary) [ $# -ge 2 ] || die "--summary needs text"; _sf_sum=$2; _sf_hs=1; shift 2 ;;
      --index)   [ $# -ge 2 ] || die "--index needs text";   _sf_idx=$2; _sf_hi=1; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  resolve_page "$_sf_pg"; _sf_rel=$PAGE_REL; _sf_name=$PAGE_NAME
  _sf_m=$(save_manifest_path "$_sf_rel")
  if [ ! -f "$_sf_m" ] || ! manifest_fresh "$_sf_m"; then
    die "no save-begin for $_sf_name in the last 12 h — run brain save-begin first"
  fi
  _sf_files="$RUN_DIR/save-finish.files"; sed -n 's/^file //p' "$_sf_m" > "$_sf_files"
  case $_sf_rel in pages/Projects___*) _sf_proj=1 ;; *) _sf_proj=0 ;; esac

  # 1. Validate.
  _sf_bad=0
  if [ "$_sf_hs" = 1 ]; then validate_text summary "$_sf_name" "$_sf_sum" || _sf_bad=1; fi
  if [ "$_sf_hi" = 1 ] && [ "$_sf_proj" = 1 ]; then validate_text index "$_sf_name" "$_sf_idx" || _sf_bad=1; fi
  [ "$_sf_bad" = 0 ] || exit 1
  _sf_maps="$RUN_DIR/save-finish.maps"; : > "$_sf_maps"; _sf_over=0; _sf_i=0
  while IFS= read -r _sf_f || [ -n "$_sf_f" ]; do
    case $_sf_f in pages/Projects___*|pages/Tasks___*) ;; *) continue ;; esac
    [ -f "$GRAPH/$_sf_f" ] || continue
    PAGE_REL=$_sf_f; PAGE_NAME=$(basename "$_sf_f" .md | sed 's#___#/#g'); archive_of
    _sf_rep="$RUN_DIR/save-finish.report"
    digest_report "$GRAPH/$_sf_f" > "$_sf_rep"
    grep -q '^digest: not applicable' "$_sf_rep" && continue
    # An --also page with no ## Digest yet is not this save's to backfill; the saved page is.
    if [ "$_sf_f" != "$_sf_rel" ] && grep -q '^digest: missing' "$_sf_rep"; then continue; fi
    if grep -q '^over: ' "$_sf_rep"; then
      if [ "$_sf_f" = "$_sf_rel" ]; then grep '^over: ' "$_sf_rep"
      else grep '^over: ' "$_sf_rep" | sed "s#^#$_sf_f: #"; fi
      _sf_over=1; continue
    fi
    _sf_i=$((_sf_i + 1)); _sf_out="$RUN_DIR/save-finish.map.$_sf_i"
    _sf_ck=$(cksum < "$GRAPH/$_sf_f")
    apply_compute "$GRAPH/$_sf_f" "$_sf_out" || exit 2      # map.awk or apply_compute named the reason
    printf '%s\t%s\t%s\n' "$_sf_f" "$_sf_out" "$_sf_ck" >> "$_sf_maps"
  done < "$_sf_files"
  if [ "$_sf_over" = 1 ]; then echo "fix the digest with one Edit and rerun this same command"; exit 1; fi

  # 2-3. The two text writes.
  if [ "$_sf_hs" = 1 ]; then echo "== sessions"; write_sessions "$_sf_name" "$_sf_sum"; fi
  if [ "$_sf_hi" = 1 ]; then
    echo "== index"
    case $_sf_rel in
      pages/Projects___*) write_index "$_sf_name" "$_sf_idx" ;;
      pages/Tasks___*)    echo "index: not applicable (task page)" ;;
      *)                  echo "index: not applicable (not a project page)" ;;
    esac
  fi

  # 4. The Maps, then the saved page's report.
  echo "== map"
  while IFS="$TAB" read -r _sf_f _sf_out _sf_ck || [ -n "$_sf_f" ]; do
    apply_commit "$_sf_f" "$_sf_out" "$_sf_ck"
  done < "$_sf_maps"
  PAGE_REL=$_sf_rel; PAGE_NAME=$_sf_name; archive_of
  digest_report "$GRAPH/$_sf_rel" > "$_sf_rep"
  if grep -q '^digest: not applicable' "$_sf_rep"; then echo "map: not applicable"; else cat "$_sf_rep"; fi

  # 5. One check over the save set. A file absent now that was absent at save-begin was not written.
  echo "== check"
  set --
  while IFS= read -r _sf_f || [ -n "$_sf_f" ]; do
    _sf_b="$STATE_DIR/base/$(printf '%s' "$_sf_f" | sed 's#/#%#g')"
    if [ ! -f "$GRAPH/$_sf_f" ] && [ ! -s "$_sf_b" ]; then echo "check $_sf_f: not written (absent)"; continue; fi
    set -- "$@" "$_sf_f"
  done < "$_sf_files"
  _sf_crc=0
  if [ $# -gt 0 ]; then SKIP_DIGEST_LINT=; cmd_check "$@"; _sf_crc=$?; fi

  # 6. The activity line.
  echo "== activity"
  if [ "$_sf_crc" = 0 ]; then
    cmd_activity "saved [[$_sf_name]]"
    rm -f "$_sf_m"
    return 0
  fi
  _sf_q=; for _sf_f in "$@"; do _sf_q="$_sf_q '$_sf_f'"; done
  printf "activity: deferred — fix the errors above, then run: brain check%s && brain activity 'saved [[%s]]'\n" "$_sf_q" "$_sf_name"
  return 1
}

# manifest_fresh FILE — its ts line is within the 12 h baseline expiry.
manifest_fresh() {
  _mf=$(sed -n 's/^ts //p' "$1")
  case $_mf in ''|*[!0-9]*) return 1 ;; esac
  [ $(( $(date +%s) - _mf )) -le 43200 ]
}

cmd_status() {
  _list="$RUN_DIR/status.lst"
  (cd "$GRAPH" && ls pages/Projects___*.md pages/Tasks___*.md 2>/dev/null) | grep -v '___SessionArchive\.md$' > "$_list"
  (cd "$GRAPH" && run_awk status -v listfile="$_list" -v today="$TODAY")
  _rc=$?
  [ "$_rc" = 0 ] || die "status failed (awk exit $_rc)"
}

# --- commands end ---

# --graph is accepted anywhere on the line: models write `brain info --graph DIR`, and a flag the
# loop stopped short of used to run silently against the configured graph (and land in activity
# text). `--` ends flag parsing and is consumed. The loop rotates "$@" in place: each argument is
# either taken as the flag (with its value) or re-appended, so kept arguments keep their exact bytes.
OPT_GRAPH=; _gset=0; _dd=0; _n=$#
while [ "$_n" -gt 0 ]; do
  _a=$1; shift; _n=$((_n - 1))
  if [ "$_dd" = 1 ]; then set -- "$@" "$_a"; continue; fi
  case $_a in
    --)        _dd=1 ;;
    --graph)   [ "$_n" -ge 1 ] || die "--graph needs a directory"
               [ "$_gset" = 0 ] || die "--graph given twice"
               OPT_GRAPH=$1; _gset=1; shift; _n=$((_n - 1)) ;;
    --graph=*) [ "$_gset" = 0 ] || die "--graph given twice"
               OPT_GRAPH=${_a#--graph=}; _gset=1 ;;
    *)         set -- "$@" "$_a" ;;
  esac
done
# An empty value would fall through to LOGSEQ_BRAIN_PATH or the config: the wrong-graph bug again.
[ "$_gset" = 0 ] || [ -n "$OPT_GRAPH" ] || die "--graph needs a directory"
cmd=${1:-help}; [ $# -gt 0 ] && shift
case $cmd in
  help|-h|--help)    usage ;;
  version|--version) echo "logseq-brain $BRAIN_VERSION" ;;
  info)              resolve_graph; cmd_info ;;
  sections)          resolve_graph; init_run; cmd_sections "$@" ;;
  read)              resolve_graph; cmd_read_tail read "$@" ;;
  tail)              resolve_graph; cmd_read_tail tail "$@" ;;
  digest)            resolve_graph; init_run; cmd_digest "$@" ;;
  lint)              resolve_graph; init_run; cmd_lint "$@" ;;
  check)             resolve_graph; init_run; cmd_check "$@" ;;
  search)            resolve_graph; init_run; cmd_search "$@" ;;
  journal)           resolve_graph; init_run; cmd_journal "$@" ;;
  activity)          resolve_graph; init_run; cmd_activity "$@" ;;
  status)            resolve_graph; init_run; cmd_status ;;
  load)              resolve_graph; init_run; cmd_load "$@" ;;
  save-begin)        resolve_graph; init_run; cmd_save_begin "$@" ;;
  save-finish)       resolve_graph; init_run; cmd_save_finish "$@" ;;
  # Test-only arms: each new writer and the validator alone (tests/cases/sessions-*, index-*, validate-*).
  _write-sessions|_write-index|_validate)
    [ "${BRAIN_TEST_INTERNAL:-}" = 1 ] || die "unknown command: $cmd (try: brain help)"
    resolve_graph; init_run
    case $cmd in
      _write-sessions) write_sessions "$1" "$2" ;;
      _write-index)    write_index "$1" "$2" ;;
      _validate)       validate_text "$1" "$2" "$3" || exit 1 ;;
    esac ;;
  # --- dispatch end ---
  *) die "unknown command: $cmd (try: brain help)" ;;
esac
