#!/bin/sh
# logseq-brain helper — invoke as: sh <plugin>/skills/_shared/bin/brain [--graph DIR] <command> [args]
# How skills call it: skills/_shared/run-brain.md
# Design: docs/superpowers/specs/2026-09-11-v0.11.0-design.md
set -u
LC_ALL=C; export LC_ALL
BRAIN_VERSION=0.11.0
BIN_DIR=$(cd "$(dirname "$0")" && pwd)
LIB=$(cd "$BIN_DIR/../lib" && pwd)
AWK=${BRAIN_AWK:-awk}

die() { printf 'brain: %s\n' "$1" >&2; exit "${2:-2}"; }

usage() {
  cat <<'EOF'
usage: brain [--graph DIR] <command> [args]
  info                                  version, graph source, awk in use
  sections <page> [--baseline FILE…]    section table; records baselines for check
  read <page> <section> [--max BYTES]   whole section if under the cap (default 8192)
  tail <page> <section> [--entries N] [--max BYTES]
  digest <page> [--apply]               digest + checks; --apply rewrites only the Map line
  search <term> [--page P] [--section S] [--context N]
  journal <page> [--date yyyy-MM-dd]    that page's mentions in a journal, shrunk to ~2 KB
  check <file…>                         lint lines added since each file's baseline
  lint [--all | <file…>]                every rule over whole files
  status                                one TSV row per project and task page
  activity <line>                       append "HH:MM <line>" under today's ## Activity
EOF
}

to_posix() {
  case $1 in
    *\\*|?:*)
      if command -v cygpath >/dev/null 2>&1; then cygpath -u "$1"
      else printf '%s\n' "$1" | tr '\\' '/'; fi ;;
    *) printf '%s\n' "$1" ;;
  esac
}

config_file() {
  if [ -n "${APPDATA:-}" ]; then printf '%s/logseq-brain/config.json\n' "$(to_posix "$APPDATA")"
  elif [ -n "${XDG_CONFIG_HOME:-}" ]; then printf '%s/logseq-brain/config.json\n' "$XDG_CONFIG_HOME"
  else printf '%s/.config/logseq-brain/config.json\n' "$HOME"; fi
}

# json_get KEY FILE — scalar value of "KEY" (string, bool or number); JSON \x escapes undone.
json_get() {
  [ -r "$2" ] || return 0
  $AWK -v BINMODE=3 -v k="$1" 'BEGIN { RS = "\001" }
  {
    s = $0; i = index(s, "\"" k "\""); if (!i) exit
    s = substr(s, i + length(k) + 2); sub(/^[ \t\r\n]*:[ \t\r\n]*/, "", s)
    if (substr(s, 1, 1) == "\"") {
      out = ""
      for (j = 2; j <= length(s); j++) {
        c = substr(s, j, 1)
        if (c == "\\") { j++; out = out substr(s, j, 1); continue }
        if (c == "\"") break
        out = out c
      }
      print out
    } else if (match(s, /^[A-Za-z0-9.]+/)) print substr(s, RSTART, RLENGTH)
    exit
  }' "$2"
}

GRAPH=; GRAPH_SRC=
resolve_graph() {
  for src in flag env config; do
    case $src in
      flag)   g=${OPT_GRAPH:-} ;;
      env)    g=${LOGSEQ_BRAIN_PATH:-} ;;
      config) g=$(json_get graphPath "$(config_file)") ;;
    esac
    [ -n "$g" ] || continue
    g=$(to_posix "$g")
    if [ -d "$g" ]; then GRAPH=${g%/}; GRAPH_SRC=$src; return 0; fi
    [ "$src" = flag ] && die "graph not found: $g"
  done
  die "graph not resolved — pass --graph DIR, set LOGSEQ_BRAIN_PATH, or set graphPath in $(config_file)"
}

valid_date() {
  case $1 in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) return 0 ;; esac
  printf 'brain: not a yyyy-MM-dd date: %s\n' "$1" >&2; return 2
}
now_hm() { printf '%s\n' "${BRAIN_NOW:-$(date +%H:%M)}"; }

# State directory, run directory and today's date: resolved once, here in the main shell.
# Resolved inside $( ) instead, a die would exit only the subshell and could not stop the run —
# the caller would get a full section table *and* a failure, or a temp path at the filesystem root.
STATE_DIR=; RUN_DIR=; TODAY=; INFLIGHT=; ROLLBACK=

cleanup() {
  if [ -n "$INFLIGHT" ] && [ -n "$ROLLBACK" ] && [ -f "$ROLLBACK" ]; then
    _i=$INFLIGHT; INFLIGHT=
    if cat "$ROLLBACK" > "$GRAPH/$_i" 2>/dev/null
    then printf 'brain: interrupted mid-write — %s restored\n' "$_i" >&2
    else printf 'brain: interrupted mid-write — %s NOT restored; recover it from %s\n' "$_i" "$ROLLBACK" >&2; fi
  fi
  INFLIGHT=
  [ -n "$RUN_DIR" ] && rm -rf "$RUN_DIR"
  RUN_DIR=
  return 0
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# init_run — before any command that needs graph state or today's date. Per-run file names:
# two concurrent runs once shared check.lst/lint.out/… and reported each other's findings.
init_run() {
  TODAY=${BRAIN_TODAY:-$(date +%Y-%m-%d)}
  valid_date "$TODAY" || exit 2
  STATE_DIR="${TMPDIR:-/tmp}/logseq-brain/$(printf '%s' "$GRAPH" | cksum | cut -d' ' -f1)"
  RUN_DIR="$STATE_DIR/run.$$"
  mkdir -p "$STATE_DIR/base" "$RUN_DIR" || { RUN_DIR=; die "cannot create state dir $RUN_DIR"; }
}

nonl() {
  if [ -s "$1" ] && [ "$(tail -c 1 "$1" | wc -l | tr -d ' ')" = 0 ]; then echo 1; else echo 0; fi
}

fig() { if [ "$1" -ge 1024 ]; then echo "$(($1 / 1024)) KB"; else echo "$1 B"; fi; }

# guard_rel REL — refuse anything that could leave the graph's pages/ or journals/.
guard_rel() {
  case $1 in
    *..*|/*) die "path outside the graph: $1" ;;
    pages/*|journals/*) ;;
    *) die "path outside pages/ or journals/: $1" ;;
  esac
}

PAGE_REL=; PAGE_NAME=
resolve_page() {
  _p=$1
  case $_p in
    *.md) _rel=${_p#"$GRAPH"/}; guard_rel "$_rel" ;;
    *)    _rel="pages/$(printf '%s' "$_p" | sed 's#/#___#g').md" ;;
  esac
  if [ ! -f "$GRAPH/$_rel" ]; then
    case $_p in
      */*|*.md) ;;
      *) for _pre in Projects___ Tasks___; do
           if [ -f "$GRAPH/pages/$_pre$_p.md" ]; then _rel="pages/$_pre$_p.md"; break; fi
         done ;;
    esac
  fi
  if [ ! -f "$GRAPH/$_rel" ]; then
    printf 'brain: page not found: %s\n' "$_p" >&2
    _key=$(printf '%s' "$_p" | sed 's#\.md$##; s#___#/#g; s#.*/##')
    ls "$GRAPH/pages" 2>/dev/null | sed 's#\.md$##; s#___#/#g' | grep -i -F -- "$_key" \
      | head -n 5 | sed 's/^/  did you mean: /' >&2
    exit 2
  fi
  PAGE_REL=$_rel
  PAGE_NAME=$(basename "$_rel" .md | sed 's#___#/#g')
}

# run_awk PROG [awk args…] — core.awk is always loaded first.
# BINMODE=3: gawk on Windows otherwise reads in text mode and drops \r. Other awks ignore it.
run_awk() { _prog=$1; shift; $AWK -v BINMODE=3 -f "$LIB/core.awk" -f "$LIB/$_prog.awk" "$@"; }

cmd_info() {
  echo "logseq-brain $BRAIN_VERSION"
  echo "graph-source: $GRAPH_SRC"
  # The one absolute path the helper prints: skills use it for their own Read/Edit/Write.
  printf 'graph: %s\n' "$(cygpath -m "$GRAPH" 2>/dev/null || printf '%s' "$GRAPH")"
  _v=$($AWK --version 2>/dev/null | head -n 1)
  [ -n "$_v" ] || _v=$($AWK -W version 2>/dev/null | head -n 1)
  echo "awk: ${_v:-unknown}"
}

# save_baseline REL — snapshot a graph file (empty if it does not exist yet) for `brain check`.
save_baseline() {
  guard_rel "$1"
  _sd="$STATE_DIR/base"
  _key=$(printf '%s' "$1" | sed 's#/#%#g')
  if [ -f "$GRAPH/$1" ]; then cp "$GRAPH/$1" "$_sd/$_key"; else : > "$_sd/$_key"; fi
  date +%s > "$_sd/$_key.ts"
}

cmd_sections() {
  [ $# -ge 1 ] || die "usage: brain sections <page> [--baseline FILE…]"
  resolve_page "$1"; shift
  _f="$GRAPH/$PAGE_REL"
  run_awk sections -v rel="$PAGE_REL" -v nonl="$(nonl "$_f")" "$_f" || die "sections failed on $PAGE_REL"
  save_baseline "$PAGE_REL"; _saved=$PAGE_REL
  if [ "${1:-}" = --baseline ]; then
    shift
    for _b in "$@"; do _b=${_b#"$GRAPH"/}; save_baseline "$_b"; _saved="$_saved $_b"; done
  fi
  printf '# baseline saved: %s\n' "$_saved"
}

# cmd_read_tail read|tail <page> <section> [--max BYTES] [--entries N]
cmd_read_tail() {
  _mode=$1; shift
  [ $# -ge 2 ] || die "usage: brain $_mode <page> <section> [--max BYTES] [--entries N]"
  resolve_page "$1"; _sec=$2; shift 2
  if [ "$_mode" = read ]; then _max=8192; else _max=4096; fi
  _n=3
  while [ $# -gt 0 ]; do
    case $1 in
      --max)     [ $# -ge 2 ] || die "--max needs a number"; _max=$2; shift 2 ;;
      --entries) [ $# -ge 2 ] || die "--entries needs a number"; _n=$2; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  _f="$GRAPH/$PAGE_REL"
  # Same guard as digest_report, without a state dir: read/tail must work on an unwritable TMPDIR.
  # $( ) strips the trailing newline that printf puts back, so the bytes are unchanged.
  _out=$(run_awk read -v rel="$PAGE_REL" -v nonl="$(nonl "$_f")" -v mode="$_mode" \
    -v sec="$_sec" -v max="$_max" -v entries="$_n" "$_f"); _rc=$?
  [ "$_rc" = 2 ] && exit 2                              # read.awk already named the reason
  [ "$_rc" -le 1 ] || die "$_mode failed on $PAGE_REL (awk exit $_rc)"
  [ -n "$_out" ] || die "$_mode failed on $PAGE_REL — the read engine produced no output"
  printf '%s\n' "$_out"
  return $_rc
}

ARCH=
archive_of() {  # sets ARCH for a project page that has a SessionArchive page
  ARCH=
  case $PAGE_REL in
    pages/Projects___*) [ -f "$GRAPH/${PAGE_REL%.md}___SessionArchive.md" ] && ARCH="[[$PAGE_NAME/SessionArchive]]" ;;
  esac
}

# map_awk MODE FILE — map.awk over FILE (PAGE_REL/ARCH already set).
map_awk() {
  run_awk map -v rel="$PAGE_REL" -v nonl="$(nonl "$2")" -v today="$TODAY" -v archive="$ARCH" -v mode="$1" "$2"
}

# digest_report FILE — map.awk's report, guarded. Exit 1 here means findings (§1.4); any other
# code, or no output at all, means the engine never ran and must not be reported as findings.
digest_report() {
  _ro="$RUN_DIR/report.out"
  map_awk report "$1" > "$_ro"; _rc=$?
  [ "$_rc" -le 1 ] || die "digest failed on $PAGE_REL (awk exit $_rc)"
  [ -s "$_ro" ] || die "digest failed on $PAGE_REL — the report engine produced no output"
  cat "$_ro"
  return $_rc
}

cmd_digest() {
  [ $# -ge 1 ] || die "usage: brain digest <page> [--apply]"
  resolve_page "$1"; shift
  archive_of
  if [ "${1:-}" = --apply ]; then cmd_digest_apply; return; fi
  digest_report "$GRAPH/$PAGE_REL"
}

# commit_write REL TMP MAX_OLD MAX_NEW SUM_BEFORE [WANT] — verify TMP against the target, then write in place.
commit_write() {
  case $1 in
    *..*|/*) rm -f "$2"; die "refusing to write outside the graph: $1" ;;
    pages/*.md|journals/*.md) ;;
    *) rm -f "$2"; die "refusing to write outside pages/ or journals/: $1" ;;
  esac
  _t="$GRAPH/$1"; _old=$_t
  [ -f "$_t" ] || _old=/dev/null
  if [ -f "$_t" ] && cmp -s "$2" "$_t"; then rm -f "$2"; COMMITTED=0; return 0; fi
  if ! $AWK -v BINMODE=3 -v max_old="$3" -v max_new="$4" -v want="${6:-}" -f "$LIB/onechange.awk" "$_old" "$2"; then
    rm -f "$2"; exit 2
  fi
  if [ -f "$_t" ] && [ "$(nonl "$_t")" != "$(nonl "$2")" ]; then
    rm -f "$2"; die "refusing to write — final-newline status of $1 would change"
  fi
  [ -n "${BRAIN_TEST_MUTATE_BEFORE_COMMIT:-}" ] && printf ' ' >> "$_t"   # test-only hook
  if [ -f "$_t" ]; then _now=$(cksum < "$_t"); else _now=absent; fi
  if [ "$_now" != "$5" ]; then rm -f "$2"; die "$1 changed during apply — rerun"; fi
  cat "$2" > "$_t" || { rm -f "$2"; die "write failed: $1"; }
  rm -f "$2"; COMMITTED=1
}

cmd_digest_apply() {
  _f="$GRAPH/$PAGE_REL"
  _sum=$(cksum < "$_f")
  _tmp="$RUN_DIR/apply"
  map_awk apply "$_f" > "$_tmp"; _rc=$?
  if [ "$_rc" = 2 ]; then rm -f "$_tmp"; exit 2; fi      # map.awk already named the reason
  if [ "$_rc" != 0 ]; then rm -f "$_tmp"; die "digest failed on $PAGE_REL (awk exit $_rc)"; fi
  [ -s "$_tmp" ] || { rm -f "$_tmp"; die "digest failed on $PAGE_REL — the apply engine produced no output"; }
  commit_write "$PAGE_REL" "$_tmp" 1 1 "$_sum" '^[ \t]*- Map: '
  if [ "$COMMITTED" = 1 ]; then printf 'applied: Map line written to %s\n' "$PAGE_REL"
  else printf 'unchanged: Map line already current in %s\n' "$PAGE_REL"; fi
  digest_report "$_f"; _r1=$?
  echo "--"
  SKIP_DIGEST_LINT=1 cmd_check "$PAGE_REL"; _r2=$?
  [ "$_r1" = 0 ] && [ "$_r2" = 0 ]
}

graph_lists() {
  PAGES_LST="$RUN_DIR/pages.lst"; KEYS_LST="$RUN_DIR/keys.lst"
  ls "$GRAPH/pages" 2>/dev/null | sed -n 's#\.md$##p' | sed 's#___#/#g' | tr 'A-Z' 'a-z' > "$PAGES_LST"
  (cd "$GRAPH" && grep -h -E '^[[:space:]]*(- )?[A-Za-z0-9_][A-Za-z0-9_.-]*:: ' pages/*.md journals/*.md 2>/dev/null) \
    | sed -E 's/^[[:space:]]*(- )?([A-Za-z0-9_][A-Za-z0-9_.-]*)::.*/\2/' | tr 'A-Z' 'a-z' | sort | uniq -c > "$KEYS_LST"
}

# digest_lint REL — map.awk lint findings for one digest-bearing candidate.
digest_lint() {
  case $1 in
    pages/Projects___*|pages/Tasks___*)
      PAGE_REL=$1; PAGE_NAME=$(basename "$1" .md | sed 's#___#/#g'); archive_of
      map_awk lint "$GRAPH/$1" ;;
  esac
  return 0
}

cmd_check() {
  [ $# -ge 1 ] || die "usage: brain check <file|page>…"
  graph_lists
  _crc=0
  for _a in "$@"; do
    _rel=${_a#"$GRAPH"/}
    case $_rel in pages/*|journals/*) guard_rel "$_rel" ;; *) resolve_page "$_a"; _rel=$PAGE_REL ;; esac
    [ -f "$GRAPH/$_rel" ] || die "no such file: $_rel"
    _b="$STATE_DIR/base/$(printf '%s' "$_rel" | sed 's#/#%#g')"
    _list="$RUN_DIR/check.lst"; printf '%s\n' "$_rel" > "$_list"
    _fresh=0
    if [ -f "$_b" ] && [ -f "$_b.ts" ]; then
      _ts=$(cat "$_b.ts")
      case $_ts in
        ''|*[!0-9]*) ;;
        *) [ $(( $(date +%s) - _ts )) -le 43200 ] && _fresh=1 ;;
      esac
    fi
    _lo="$RUN_DIR/check-lint.out"; _cnt="$RUN_DIR/check.cnt"; : > "$_cnt"
    if [ "$_fresh" = 1 ]; then
      _add="$RUN_DIR/added.lst"
      $AWK -v BINMODE=3 -f "$LIB/added.awk" "$_b" "$GRAPH/$_rel" > "$_add" \
        || die "check failed on $_rel — could not diff it against its baseline"
      (cd "$GRAPH" && run_awk lint -v listfile="$_list" -v pagesfile="$PAGES_LST" -v keysfile="$KEYS_LST" \
        -v addedfile="$_add" -v countfile="$_cnt") > "$_lo"
    else
      (cd "$GRAPH" && run_awk lint -v listfile="$_list" -v pagesfile="$PAGES_LST" -v keysfile="$KEYS_LST" \
        -v nobase=1 -v countfile="$_cnt") > "$_lo"
    fi
    _lrc=$?
    [ "$_lrc" = 2 ] && exit 2                           # lint.awk already named the unreadable file
    [ "$_lrc" -le 1 ] || die "check failed on $_rel (lint engine exit $_lrc)"
    # The verification step of a save: an engine that did not lint the file must not read as clean.
    _nf=$(cut -f1 "$_cnt")
    [ "${_nf:-}" = 1 ] || die "check failed on $_rel — the engine linted ${_nf:-no} file(s), expected 1"
    _ne=$(cut -f2 "$_cnt"); _nw=$(cut -f3 "$_cnt"); _pre=$(cut -f4 "$_cnt")
    [ "$_lrc" = 1 ] && _crc=1
    cat "$_lo"
    _ds=
    if [ -z "${SKIP_DIGEST_LINT:-}" ]; then
      _dl="$RUN_DIR/check-digest.out"
      digest_lint "$_rel" > "$_dl"; cat "$_dl"
      # Named in the summary, so the summary and the exit code agree: a page whose only new problem
      # is a digest finding used to print "0 new (0 error, 0 warn)" and exit 1.
      _de=$(cut -f3 "$_dl" | grep -c '^error$'); _dw=$(cut -f3 "$_dl" | grep -c '^warn$')
      [ $((_de + _dw)) -gt 0 ] && _ds=" · digest: $_de error, $_dw warn"
      if [ "$_fresh" = 1 ] && [ "$_de" -gt 0 ]; then _crc=1; fi
    fi
    if [ "$_fresh" = 1 ]; then
      printf 'check %s: %d new (%d error, %d warn), %d pre-existing%s\n' \
        "$_rel" "$((_ne + _nw))" "$_ne" "$_nw" "$_pre" "$_ds"
    else
      printf 'check %s: no baseline — %d finding(s) shown, may be pre-existing%s\n' \
        "$_rel" "$((_ne + _nw))" "$_ds"
    fi
  done
  return $_crc
}

cmd_lint() {
  graph_lists
  _list="$RUN_DIR/lint.lst"; _out="$RUN_DIR/lint.out"
  if [ $# -eq 0 ] || [ "$1" = --all ]; then
    # Two ls calls, not one: a single `ls pages/*.md journals/*.md` sorts journals/ before pages/.
    (cd "$GRAPH" && { ls pages/*.md 2>/dev/null; ls journals/*.md 2>/dev/null; }) > "$_list"
  else
    : > "$_list"
    for _a in "$@"; do
      _r=${_a#"$GRAPH"/}; guard_rel "$_r"
      [ -f "$GRAPH/$_r" ] || die "no such file: $_r"
      printf '%s\n' "$_r" >> "$_list"
    done
  fi
  _cnt="$RUN_DIR/lint.cnt"; : > "$_cnt"
  (cd "$GRAPH" && run_awk lint -v listfile="$_list" -v pagesfile="$PAGES_LST" -v keysfile="$KEYS_LST" \
    -v countfile="$_cnt") > "$_out"
  _lrc=$?
  [ "$_lrc" = 2 ] && exit 2                             # lint.awk already named the unreadable file
  [ "$_lrc" = 0 ] || die "lint failed (lint engine exit $_lrc)"
  # An engine that linted fewer files than were listed must not report a clean graph: an empty or
  # truncated count file is a failure, not "0 error, 0 warn".
  _want=$(wc -l < "$_list" | tr -d ' '); _nf=$(cut -f1 "$_cnt")
  [ "${_nf:-}" = "$_want" ] || die "lint failed — the engine linted ${_nf:-no} of $_want file(s)"
  while IFS= read -r _r || [ -n "$_r" ]; do digest_lint "$_r" >> "$_out"; done < "$_list"
  cat "$_out"
  _e=$(cut -f3 "$_out" | grep -c '^error$'); _w=$(cut -f3 "$_out" | grep -c '^warn$')
  _by=$(cut -f2 "$_out" | sort | uniq -c | $AWK '{ printf "%s%s=%s", (NR > 1 ? " · " : ""), $2, $1 }')
  echo "summary: $_e error, $_w warn${_by:+ · $_by}"
  [ $((_e + _w)) -eq 0 ]
}

cmd_search() {
  [ $# -ge 1 ] || die "usage: brain search <term> [--page P] [--section S] [--context N]"
  _term=$1; shift; _pg=; _sec=; _ctx=
  while [ $# -gt 0 ]; do
    case $1 in
      --page)    [ $# -ge 2 ] || die "--page needs a page";     _pg=$2;  shift 2 ;;
      --section) [ $# -ge 2 ] || die "--section needs a name";  _sec=$2; shift 2 ;;
      --context) [ $# -ge 2 ] || die "--context needs a number"; _ctx=$2; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -n "$_sec" ] && [ -z "$_pg" ] && die "--section needs --page"
  _list="$RUN_DIR/search.lst"
  if [ -n "$_pg" ]; then
    resolve_page "$_pg"; printf '%s\n' "$PAGE_REL" > "$_list"; _scope="$PAGE_REL${_sec:+ ## $_sec}"
  else
    (cd "$GRAPH" && { ls pages/*.md 2>/dev/null; ls journals/*.md 2>/dev/null; }) > "$_list"; _scope="pages/, journals/"
  fi
  if [ -n "$_ctx" ]; then
    while IFS= read -r _f || [ -n "$_f" ]; do printf '%s\t%s\n' "$_f" "$(nonl "$GRAPH/$_f")"; done < "$_list" > "$_list.n" && mv "$_list.n" "$_list"
  fi
  (cd "$GRAPH" && BRAIN_TERM=$_term run_awk search -v listfile="$_list" -v sec="$_sec" -v ctx="$_ctx" -v scope="$_scope")
  _rc=$?
  [ "$_rc" = 2 ] && exit 2                              # search.awk already named the reason
  [ "$_rc" = 0 ] || die "search failed (awk exit $_rc)"
}

cmd_journal() {
  [ $# -ge 1 ] || die "usage: brain journal <page> [--date yyyy-MM-dd]"
  resolve_page "$1"; shift
  _d=$TODAY
  if [ "${1:-}" = --date ]; then [ $# -ge 2 ] || die "--date needs yyyy-MM-dd"; _d=$2; valid_date "$_d" || exit 2; fi
  _rel="journals/$(printf '%s' "$_d" | tr '-' '_').md"
  if [ ! -f "$GRAPH/$_rel" ]; then printf 'coverage: no journal for %s (%s)\n' "$_d" "$_rel"; return 0; fi
  run_awk journal -v rel="$_rel" -v nonl="$(nonl "$GRAPH/$_rel")" -v name="$PAGE_NAME" -v target=2048 "$GRAPH/$_rel"
  _rc=$?
  [ "$_rc" = 0 ] || die "journal failed on $_rel (awk exit $_rc)"
}

cmd_activity() {
  [ $# -ge 1 ] || die "usage: brain activity <text>"
  if [ "$(json_get journeyLog "$(config_file)")" = false ]; then echo "journey log disabled (journeyLog: false)"; return 0; fi
  _d=$TODAY; _rel="journals/$(printf '%s' "$_d" | tr '-' '_').md"; _t="$GRAPH/$_rel"
  _line="$(now_hm) $*"
  _tmp="$RUN_DIR/activity"
  if [ -f "$_t" ]; then
    _sum=$(cksum < "$_t")
    BRAIN_BULLET=$_line run_awk activity -v nonl="$(nonl "$_t")" -v new=0 "$_t" > "$_tmp" || { rm -f "$_tmp"; die "activity failed on $_rel"; }
    commit_write "$_rel" "$_tmp" 0 2 "$_sum"
  else
    mkdir -p "$GRAPH/journals" || die "cannot create journals/"
    BRAIN_BULLET=$_line run_awk activity -v new=1 /dev/null > "$_tmp" || { rm -f "$_tmp"; die "activity failed on $_rel"; }
    commit_write "$_rel" "$_tmp" 0 3 absent
  fi
  printf 'activity: %s → %s\n' "$_line" "$_rel"      # not echo: dash's echo expands backslashes
}

cmd_status() {
  _list="$RUN_DIR/status.lst"
  (cd "$GRAPH" && ls pages/Projects___*.md pages/Tasks___*.md 2>/dev/null) | grep -v '___SessionArchive\.md$' > "$_list"
  (cd "$GRAPH" && run_awk status -v listfile="$_list" -v today="$TODAY")
  _rc=$?
  [ "$_rc" = 0 ] || die "status failed (awk exit $_rc)"
}

# --- commands end ---

OPT_GRAPH=
while [ $# -gt 0 ]; do
  case $1 in
    --graph)   [ $# -ge 2 ] || die "--graph needs a directory"; OPT_GRAPH=$2; shift 2 ;;
    --graph=*) OPT_GRAPH=${1#--graph=}; shift ;;
    *) break ;;
  esac
done
cmd=${1:-help}; [ $# -gt 0 ] && shift
case $cmd in
  help|-h|--help)    usage ;;
  version|--version) echo "logseq-brain $BRAIN_VERSION" ;;
  info)              resolve_graph; cmd_info ;;
  sections)          resolve_graph; init_run; cmd_sections "$@" ;;
  read)              resolve_graph; cmd_read_tail read "$@" ;;
  tail)              resolve_graph; cmd_read_tail tail "$@" ;;
  digest)            resolve_graph; init_run; cmd_digest "$@" ;;
  lint)              resolve_graph; init_run; cmd_lint "$@" ;;
  check)             resolve_graph; init_run; cmd_check "$@" ;;
  search)            resolve_graph; init_run; cmd_search "$@" ;;
  journal)           resolve_graph; init_run; cmd_journal "$@" ;;
  activity)          resolve_graph; init_run; cmd_activity "$@" ;;
  status)            resolve_graph; init_run; cmd_status ;;
  # --- dispatch end ---
  *) die "unknown command: $cmd (try: brain help)" ;;
esac
